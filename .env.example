# SECRETS_BACKEND=aws-ssm   # with SSM_PATH=/dex/clients and AWS_REGION

# required for the vault backend
VAULT_MOUNT_POINT=kv
VAULT_CLIENTS_PATH=dex

VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
DEX_GRPC_URL=127.0.0.1:5557

LOG_LEVEL=DEBUG
SYNC_INTERVAL=30
# SYNC_DRY_RUN=true
# SYNC_PRUNE=true
# SYNC_PRUNE_PREFIX=vault-
METRICS_PORT=8100
